# ============================================================
# Multi-agent-IM 开发环境变量
# 复制此文件为 .env 并根据需要修改
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=maim
DB_PASSWORD=maim_dev
DB_NAME=multiagent
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
IM_CORE_ADDR=localhost:8080

# Agent Runtime
GRPC_PORT=50051

# ── LLM Provider ──────────────────────────────────────────
# Choose one: claude | openai_compatible
# For openai_compatible, set provider to: openai | deepseek | gemini | groq | custom
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-chat

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DeepSeek (recommended — cheap, Chinese-friendly)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI (ChatGPT / GPT-4o)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Groq (fast open-source models)
GROQ_API_KEY=your-groq-api-key-here

# Generic fallback
LLM_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=debug

# Auth (dev only — change in production!)
AUTH_SECRET=dev-secret-change-in-production
