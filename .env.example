# ============================================================
# Multi-agent-IM 开发环境变量
# 复制此文件为 .env 并根据需要修改
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=maim
DB_PASSWORD=maim_dev
DB_NAME=multiagent
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
IM_CORE_ADDR=localhost:8080

# Agent Runtime
GRPC_PORT=50051
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=debug

# Auth (dev only — change in production!)
AUTH_SECRET=dev-secret-change-in-production
